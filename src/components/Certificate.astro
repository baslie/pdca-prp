---
import { Icon } from 'astro-icon/components';
import euclidesCoimbra from '../assets/images/euclides-coimbra.png';
import kaizenInstitute from '../assets/images/kaizen-institute.png';

interface Props {
  /** Скан сертификата. Пока не получен — вместо превью рендерится лист-заглушка,
      без кнопки и подсказки: открывать в лайтбоксе нечего. Как подключить
      настоящий документ — см. комментарий в src/pages/index.astro. */
  image?: ImageMetadata;
}

const { image } = Astro.props;

// Медальон — квадратный кроп на лицо. Кадрирование задаёт .certificate-medallion
// в global.css, сюда приходит только URL импортированного ассета.
const medallionStyle = `background-image: url('${euclidesCoimbra.src}');`;
---

<!-- ========== БЛОК «СЕРТИФИКАТ» ==========
     Финальный блок страницы. relative z-10 + непрозрачный bg обязательны:
     без них сквозь секцию проступают fixed-слои hero (Денис и гора). -->
<section id="certificate" class="relative z-10 bg-wire-bg section-py">
  <div class="w-full section-px">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 lg:gap-14 xl:gap-20 items-center">

      <!-- Текст. Первым в DOM — на мобильном заголовок должен идти раньше документа. -->
      <div class="lg:col-span-7">
        <p class="t-eyebrow t-on-muted mb-6">Международное признание</p>
        <h2 class="t-h-section t-on-brand">
          Сертификат, <span class="text-wire-accent">заверенный</span> Kaizen&nbsp;Institute
        </h2>

        <p class="t-lead t-on-default mt-8 max-w-prose">
          Программу «Профессиональное решение проблем» сертифицировал
          Эвклид&nbsp;Коимбра — всемирно признанный эксперт в&nbsp;области кайдзен
          и&nbsp;бережливого производства с&nbsp;более чем 40-летним практическим опытом.
        </p>

        <!-- Подпись под документом: медальон, имя, должность — и лого института
             как «печать» справа. Должность живёт здесь, а не в лиде: рядом с
             логотипом она читается как реквизит заверителя, а в лиде дублировала
             бы уже сказанное. -->
        <div class="mt-[clamp(2rem,4vw,3.5rem)] pt-8 border-t border-neutral-200
                    flex flex-wrap sm:flex-nowrap items-center gap-x-6 xl:gap-x-8 gap-y-6">
          <div class="flex items-center gap-4 sm:gap-5 min-w-0">
            <div class="certificate-medallion w-20 h-20 sm:w-24 sm:h-24"
                 style={medallionStyle} role="img" aria-label="Эвклид Коимбра"></div>
            <div class="min-w-0">
              <p class="t-h-sub t-on-strong">Эвклид Коимбра</p>
              <p class="t-meta t-on-muted mt-0.5">Euclides Coimbra</p>
              <p class="t-body-sm t-on-default mt-1.5">
                Старший партнёр Kaizen&nbsp;Institute Western&nbsp;Europe
              </p>
            </div>
          </div>

          <img src={kaizenInstitute.src} alt="Kaizen Institute"
               width={kaizenInstitute.width} height={kaizenInstitute.height} loading="lazy"
               class="w-[150px] xl:w-[175px] h-auto shrink-0 sm:ml-auto" />
        </div>
      </div>

      <!-- Документ. До lg ограничиваем ширину: A4 во всю колонку одноколоночной
           раскладки вырастает почти на метр по высоте и превращается в простыню. -->
      <div class="lg:col-span-5 w-full max-w-[380px] mx-auto lg:max-w-none">
        {image ? (
          <>
            <button type="button" id="btn-certificate-open" class="certificate-doc"
                    aria-label="Открыть сертификат во весь экран">
              <img src={image.src} alt="Сертификат тренинга «Профессиональное решение проблем»"
                   width={image.width} height={image.height} loading="lazy"
                   class="block w-full h-full object-contain" />
              <span class="certificate-doc__hint" aria-hidden="true">
                <span>Открыть во весь экран</span>
              </span>
            </button>
            <p class="t-hint t-on-muted mt-3">Нажмите, чтобы рассмотреть документ.</p>
          </>
        ) : (
          <div class="certificate-sheet" role="img"
               aria-label="Сертификат тренинга «Профессиональное решение проблем»">
            <Icon name="lucide:award" class="w-12 h-12 t-on-soft" />
            <p class="t-eyebrow t-on-muted mt-6">Сертификат</p>
            <p class="t-body-sm t-on-muted mt-2 max-w-prose-narrow">
              Тренинг «Профессиональное решение&nbsp;проблем»
            </p>
          </div>
        )}
      </div>

    </div>
  </div>
</section>
