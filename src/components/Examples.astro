---
import { Icon } from 'astro-icon/components';
import SectionHeading from './SectionHeading.astro';
import denisBulgin2 from '../assets/images/denis-bulgin-2.jpg';
import { categories, categoryData } from '../data/examples';
---

<!-- ========== БЛОК «ПРИМЕРЫ РЕШЕНИЯ ПРОБЛЕМ» ========== -->
<!-- pb-0 — осознанное исключение из ритма: фото Дениса стоит на нижней
     границе секции (lg:self-end), любой нижний паддинг оторвал бы его от неё
     и оставил белую полосу под фигурой. -->
<section id="examples" class="relative z-10 bg-bg pt-section pb-0">
  <div class="w-full section-px">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-gutter">

      <!-- lg:pb-block компенсирует pb-0 секции: снизу колонку ограничивает
           не паддинг секции, а её собственный край, и подсказка под списком
           категорий иначе прилипает вплотную к следующей секции.
           На <lg колонка идёт над фото и отбита от него gap'ом грида. -->
      <div class="lg:col-span-7 lg:order-2 lg:self-center lg:pb-block">

        <div class="mb-block" data-reveal>
          <SectionHeading>
            <Fragment slot="eyebrow">6 областей · реальные проекты</Fragment>
            Примеры <span class="text-brand-red">решения</span> проблем
          </SectionHeading>
          <p class="t-hint t-on-muted mt-4 lg:hidden">
            Нажмите на категорию, чтобы посмотреть список проектов.
          </p>
        </div>

        <!-- Каждая категория — H3 под H2 секции. Кнопка живёт ВНУТРИ заголовка
             (паттерн WAI-ARIA для аккордеонов), а не наоборот: <h3> — flow
             content и внутрь <button> по HTML не помещается, да и содержимое
             кнопки в a11y-дереве всё равно схлопывается в её имя. -->
        <!-- Карточки без обрамляющей рамки — стаггер разрешён (паттерн
             OfferStats.astro). h-full-цепочка выравнивает высоту в ряду.
             Сетка 1→2→1→2 по фактической ширине КОЛОНКИ, не вьюпорта:
             на md (768+) две карточки в ряд дают тексту ≥190px; на lg
             колонка сжата col-span-7 (рядом фото) — ряд снова один,
             иначе «документооборот» вылезал за карточку; на xl+ два. -->
        <ul class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-1 xl:grid-cols-2 gap-3 sm:gap-4 lg:gap-5" data-reveal="group">
          {categories.map((c, i) => (
            <li style={`--reveal-i:${i}`}>
              <h3 class="h-full">
                <button type="button" class="category-card" data-category={c.id}>
                  <span class="category-card__icon">
                    <Icon name={c.icon} class="w-7 h-7" />
                  </span>
                  <span class="category-card__text flex-1">
                    <span class="category-card__title">{c.title}</span>
                    <span class="category-card__caption">{c.caption}</span>
                  </span>
                </button>
              </h3>
            </li>
          ))}
        </ul>

        <div class="mt-6 t-hint t-on-muted hidden lg:block">
          Нажмите на категорию, чтобы посмотреть список проектов.
        </div>

      </div>

      <!-- Фото Дениса — край в край. -->
      <div class="lg:col-span-5 lg:order-1 lg:self-end">
        <img src={denisBulgin2.src} alt="Денис Булгин"
             width={denisBulgin2.width} height={denisBulgin2.height} loading="lazy"
             class="w-full h-auto block" />
      </div>

    </div>

    <!-- Скрытые иконки-шаблоны для модалки категорий (JS клонирует по data-category). -->
    <div id="examples-icons-templates" hidden>
      {categories.map((c) => (
        <span data-icon-for={c.id}>
          <Icon name={c.icon} class="w-7 h-7" />
        </span>
      ))}
    </div>

    <!-- Полный список реальных проектов для индексации поисковиками и AI-краулерами. -->
    <div class="sr-only" id="examples-projects-data" aria-hidden="true">
      {categoryData.map((c) => (
        <article data-category-data={c.id}>
          <h3>{c.title}</h3>
          <ul>
            {c.items.map((item) => <li>{item}</li>)}
          </ul>
        </article>
      ))}
    </div>
  </div>
</section>
