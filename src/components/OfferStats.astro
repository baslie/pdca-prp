---
import { Icon } from 'astro-icon/components';
import { formatStatNumber } from '../scripts/format';
import mountainsClouds from '../assets/images/mountains-clouds.jpg';

interface Feature {
  icon: string;
  labelHtml: string;
}

const features: Feature[] = [
  { icon: 'lucide:briefcase',            labelHtml: 'Многолетний<br />опыт' },
  { icon: 'lucide:wrench',               labelHtml: 'Все<br />инструменты' },
  { icon: 'lucide:award',                labelHtml: 'Сертификация' },
  { icon: 'lucide:message-square-quote', labelHtml: 'Рекомендации' },
  { icon: 'lucide:map-pin',              labelHtml: 'Мобильность' },
  { icon: 'lucide:file-signature',       labelHtml: 'Работа<br />по&nbsp;договору' },
];

interface Stat {
  /** Целевое значение — от нуля до него набегает счётчик (stats-counter.ts). */
  value: number;
  caption: string;
}

const stats: Stat[] = [
  { value: 22,     caption: 'года в области бизнес-обучения' },
  { value: 17,     caption: 'лет в сфере бережливого производства' },
  { value: 850,    caption: 'проведённых тренингов в России, странах СНГ и Евросоюза' },
  { value: 13_000, caption: 'довольных участников' },
];

// Формула общая с runtime-счётчиком; NBSP-разделитель — см. src/scripts/format.ts.
const formatStat = formatStatNumber;
---

<!-- ========== БЛОК «МЫ ПРЕДЛАГАЕМ + СТАТИСТИКА» ========== -->
<section
  id="offer-stats"
  class="relative z-10 overflow-hidden section-py-lg bg-cover bg-center bg-fixed"
  style={`background-image: url('${mountainsClouds.src}');`}
>
  <!-- Двухслойный overlay: «стальной» синий (.steel-overlay, см. global.css)
       вместо прежнего нейтрально-тёмного + вертикальная виньетка фирменным синим. -->
  <div class="absolute inset-0 steel-overlay" aria-hidden="true"></div>
  <div class="absolute inset-0 bg-gradient-to-b from-brand-blue/45 via-transparent to-brand-blue/35" aria-hidden="true"></div>

  <div class="relative w-full section-px">

    <div class="text-center max-w-3xl mx-auto mb-block" data-reveal>
      <p class="t-eyebrow t-on-dark-muted mb-6">Преимущества и&nbsp;цифры</p>
      <h2 class="t-h-section t-on-dark">
        Мы&nbsp;<span class="text-brand-red">предлагаем</span>
      </h2>
    </div>

    <!-- 6 преимуществ. Карточки в сетке ничем не обрамлены, поэтому здесь
         работает стаггер: --reveal-i задаёт лесенку в 60 мс на шаг. -->
    <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-6 gap-3 sm:gap-4 lg:gap-5"
         data-reveal="group">
      {features.map((f, i) => (
        <article class="feature-card" style={`--reveal-i:${i}`}>
          <Icon name={f.icon} class="feature-card__icon" />
          <p class="feature-card__label" set:html={f.labelHtml}></p>
        </article>
      ))}
    </div>

    <!-- 4 цифры. data-count-to читает src/scripts/stats-counter.ts: значение
         набегает от нуля при появлении группы. В HTML при этом лежит уже
         финальное число — без JS и для краулеров цифра сразу правильная. -->
    <div class="mt-group grid grid-cols-2 md:grid-cols-4 gap-3 sm:gap-4 lg:gap-5"
         data-reveal="group" data-stats>
      {stats.map((s, i) => (
        <article class="stat-card" style={`--reveal-i:${i}`}>
          <div class="stat-card__number" data-count-to={s.value}>{formatStat(s.value)}</div>
          <p class="stat-card__caption" set:html={s.caption}></p>
        </article>
      ))}
    </div>

    <p class="mt-group text-center t-meta t-on-dark-muted max-w-2xl mx-auto">
      22&nbsp;года опыта подкреплены сотнями тренингов и&nbsp;тысячами участников
    </p>

  </div>
</section>

<script>
  import '../scripts/stats-counter';
</script>
