---
/* ========== БЛОК «НАМ ДОВЕРЯЮТ» ==========
   Логотипы организаций, чьих сотрудников обучал Денис, плюс перечень тех,
   у кого логотипа нет. Раньше это была полоса пиллов внизу #about-trainer —
   она перенесена сюда целиком, ни одно название не потеряно.
   Данные и подготовка файлов логотипов — src/data/clients.ts. */
import { logos, CLIENTS } from '../data/clients';
---

<!-- Секция ниже hero: relative z-10 + непрозрачный фон обязательны,
     иначе сквозь неё проступают fixed-слои героики (см. docs/STACKING.md). -->
<section id="clients" class="relative z-10 bg-bg section-py">

  <div class="section-px">
    <header class="max-w-prose mx-auto text-center" data-reveal>
      <p class="t-eyebrow t-on-muted mb-6">Опыт обучения сотрудников организаций</p>
      <h2 class="t-h-section t-on-brand">
        Нам <span class="text-brand-red">доверяют</span>
      </h2>
    </header>
  </div>

  <!-- Ковёр во всю ширину: контейнера с max-w нет, только боковые поля. -->
  <ul class="flex flex-wrap justify-center items-center
             gap-x-8 gap-y-7 md:gap-x-14 md:gap-y-10
             section-px-wide mt-block">
    {logos.map((l) => (
      <li class="client-logo-cell w-[130px] h-[65px] md:w-[165px] md:h-[82px]">
        <img
          src={l.image.src}
          alt={l.name}
          title={l.name}
          width={l.image.width}
          height={l.image.height}
          loading="lazy"
          decoding="async"
          class="client-logo"
        />
      </li>
    ))}
  </ul>

  <!-- Перечень остальных организаций — тот же материал, что был в полосе
       под блоком о тренере, только на светлом фоне. -->
  <div class="section-px mt-block">
    <p class="t-eyebrow t-on-muted mb-6">А&nbsp;также</p>
    <ul class="flex flex-wrap items-center gap-2">
      {CLIENTS.map((c) => (
        <li class="client-pill">{c}</li>
      ))}
      <li class="t-meta t-on-soft">и&nbsp;др.</li>
    </ul>
  </div>

</section>
