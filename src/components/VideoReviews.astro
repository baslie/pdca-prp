---

<!-- Слайдер на всю ширину вьюпорта (без section-px на обёртке — edge bleed,
     тот же приём, что у бегущих рядов). Отступ первой карточки задаёт
     section-px на embla-контейнере: containScroll trimSnaps выравнивает
     покой по левому краю заголовка, а конец прокрутки — по правому паддингу. -->
<div
  class="video-slider relative mt-[clamp(2.5rem,5vw,4.5rem)]"
  role="region"
  aria-label="Видеоотзывы участников"
  data-video-slider
>
  <div class="video-slider__viewport" data-vr-viewport>
    <div class="flex section-px gap-4 md:gap-6">
      {VIDEO_REVIEWS.map((v, i) => {
        const meta = typografAttr([v.company, v.city].filter(Boolean).join(', '));
        return (
          <div class="video-slide">
            <button
              type="button"
              data-video-card
              data-code={v.code}
              data-name={typografAttr(v.name)}
              data-meta={meta}
              data-transcript={`vr-transcript-${i}`}
              aria-haspopup="dialog"
              aria-label={v.name ? `Видеоотзыв: ${v.name}` : `Видеоотзыв участника тренинга ${i + 1}`}
              class="video-card block w-full text-left"
            >
              <span class="video-card__frame relative block aspect-video overflow-hidden bg-panel">
                {/* width/height 960×540 — фолбэк-src совпадает с наибольшим
                    из widths, полноразмерный 1920px вариант не генерируется. */}
                <Image
                  src={v.image}
                  width={960}
                  height={540}
                  widths={[480, 768, 960]}
                  sizes="(min-width: 768px) 420px, 300px"
                  format="webp"
                  alt=""
                  loading="lazy"
                  decoding="async"
                  class="absolute inset-0 w-full h-full object-cover"
                />
                {/* Красный квадрат-бейдж с белым треугольником в правом нижнем
                    углу кадра — по центру он перекрывал лица спикеров. */}
                <svg class="video-card__play" viewBox="0 0 48 48" aria-hidden="true">
                  <rect width="48" height="48" fill="currentColor" />
                  <path fill="#fff" d="M19 15l14 9-14 9V15Z" />
                </svg>
              </span>
              {(v.name || meta) && (
                <span class="mt-3 block">
                  {v.name && <span class="block t-meta font-semibold t-on-strong">{v.name}</span>}
                  {meta && <span class="block t-hint t-on-muted mt-0.5">{meta}</span>}
                </span>
              )}
            </button>
            {/* Расшифровка: инертный template, клонируется в модалку целиком. */}
            <template id={`vr-transcript-${i}`}>
              {v.transcript.map((p) => (
                <p class="t-body t-on-default">{p}</p>
              ))}
            </template>
          </div>
        );
      })}
    </div>
  </div>

  <button type="button" data-vr-prev class="video-slider__arrow video-slider__arrow--prev" aria-label="Предыдущие видеоотзывы">
    <Icon name="lucide:chevron-left" class="w-6 h-6" aria-hidden="true" />
  </button>
  <button type="button" data-vr-next class="video-slider__arrow video-slider__arrow--next" aria-label="Следующие видеоотзывы">
    <Icon name="lucide:chevron-right" class="w-6 h-6" aria-hidden="true" />
  </button>
</div>

<script>
  import '../scripts/video-reviews';
</script>
