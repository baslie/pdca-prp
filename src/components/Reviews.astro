---
import VideoReviews from './VideoReviews.astro';
import SectionHeading from './SectionHeading.astro';
/* Имя, роль и город уезжают в data-* и всплывают в модалке через reviews.ts.
   Плагин типографирует только содержимое элементов — атрибуты правим тут.
   См. docs/TYPOGRAPHY.md, раздел 9 «Микротипографика». */
import { typografAttr } from '../../astro-typograf.config.mjs';
import { REVIEWS } from '../data/reviews';

/* Раздача по трём рядам через шаг 3 (14/14/13) — короткие панчи из курированного
   начала массива распределяются по всем рядам равномерно. */
const rows = [0, 1, 2].map((k) => REVIEWS.filter((_, i) => i % 3 === k));

/* Скорость рядов: полный цикл ~2 минуты. Средний ряд едет навстречу и медленнее
   всех — встречное движение читается даже на малой скорости. */
const rowConfig = [
  { dur: '110s', reverse: false },
  { dur: '150s', reverse: true },
  { dur: '125s', reverse: false },
];
---

<!-- ========== БЛОК «ОТЗЫВЫ» ==========
     Последняя секция страницы: слайдер видеоотзывов (VideoReviews.astro) +
     три встречных бегущих ряда текстовых карточек («Конвейер» из
     wireframes/reviews.html). relative z-10 + непрозрачный bg обязательны:
     без них сквозь секцию проступают fixed-слои hero (Денис и гора).
     Ряды ведёт reviews-marquee.ts (GSAP ticker + Observer: авто-ход, драг
     с инерцией, бесконечный wrap); CSS-анимация .marquee — no-JS-фолбэк.
     Клик по текстовой карточке открывает полный текст в <dialog>
     (ModalReview.astro, логика — src/scripts/reviews.ts, подключён там же). -->
<section id="reviews" class="relative z-10 bg-bg section-py">
  <div class="w-full section-px">
    <div class="text-center max-w-3xl mx-auto" data-reveal>
      <SectionHeading>
        <Fragment slot="eyebrow">Что говорят люди?</Fragment>
        Отзывы <span class="text-brand-red">участников</span>
      </SectionHeading>
      <p class="t-hint t-on-muted mt-4">Нажмите на&nbsp;карточку, чтобы посмотреть видео или прочитать отзыв целиком.</p>
    </div>
  </div>

  <VideoReviews />

  <!-- Ряды на всю ширину вьюпорта, без section-px. Edge-fade по краям — от фона
       секции (bg-bg) к прозрачному, чтобы карточки «выезжали из-за кулис». -->
  <div class="relative mt-block space-y-5">
    <div class="pointer-events-none absolute inset-y-0 left-0 w-12 md:w-24 z-10 bg-gradient-to-r from-bg to-transparent" aria-hidden="true"></div>
    <div class="pointer-events-none absolute inset-y-0 right-0 w-12 md:w-24 z-10 bg-gradient-to-l from-bg to-transparent" aria-hidden="true"></div>

    {rows.map((row, k) => (
      <div class="marquee" role="region" aria-label={`Отзывы, ряд ${k + 1}`}>
        <div
          class:list={['marquee__track', rowConfig[k].reverse && 'marquee__track--r']}
          style={`--marquee-dur: ${rowConfig[k].dur};`}
        >
          {[false, true].map((dup) =>
            row.map((r) => (
              <button
                type="button"
                data-review-card
                data-name={typografAttr(r.name)}
                data-role={typografAttr(r.role)}
                data-city={typografAttr(r.city)}
                class="review-card w-[300px] md:w-[360px] shrink-0 mr-4 p-5 text-left flex flex-col"
                {...(dup ? { 'data-dup': '', 'aria-hidden': 'true', tabindex: '-1' } : {})}
              >
                {/* Без `block` на тексте: он перебил бы display:-webkit-box у line-clamp */}
                <span class="review-card__text t-body-sm t-on-default line-clamp-5">{r.text}</span>
                <span class="mt-auto pt-4 flex flex-wrap items-baseline gap-x-3 gap-y-0.5">
                  <span class="review-card__name t-meta font-semibold t-on-strong">{r.name}</span>
                  <span class="review-card__meta t-hint t-on-muted">{r.city}</span>
                </span>
              </button>
            ))
          )}
        </div>
      </div>
    ))}
  </div>
</section>

<script>
  import '../scripts/reviews-marquee';
</script>
