---
import VideoReviews from './VideoReviews.astro';

/* 41 настоящий отзыв участников тренинга ПРП. Тексты дословные; правка только
   типографская (тире, «ёлочки»). Порядок курированный: сильные отзывы и панчи
   распределены так, чтобы раздача по трём рядам (шаг 3) дала каждому ряду
   свою долю коротких «выкриков». Полный текст в лайтбоксе — ModalReview.astro. */
interface Review {
  name: string;
  role: string;
  city: string;
  text: string;
}

const REVIEWS: Review[] = [
  { name: 'Евдакимов Михаил', role: 'Директор филиала', city: 'Ставрополь',
    text: 'Два дня тренинга лучше, чем пять лет в институте!!!' },
  { name: 'Гайсин Шамиль', role: 'Директор завода', city: 'Учалы',
    text: 'Есть разные методики решения проблем. Какие-то мы знаем, какие-то не знаем, некоторые забылись. Зачастую, инструментов, которые мы знаем, не хватает для выполнения тех или иных задач в полной мере. На основе тренинга «ПРП» начинаешь по-другому смотреть на решение проблем. Тренинг проходит живо, интересно. Я получил заряд энергии для решения проблем и метод решения проблем, опирающийся на углубленное рассмотрение ситуации.' },
  { name: 'Магомаева Татьяна', role: 'Заместитель директора по персоналу', city: 'Москва',
    text: 'Тренинг очень полезный, интересный и содержательный. Считаю необходимым проводить его для всех сотрудников Компании не 1 раз. Большое спасибо!' },
  { name: 'Хилалов Вадим', role: 'Директор завода', city: 'Хабаровск',
    text: 'Бережливым производством занимаюсь не первый год. С помощью вас взглянул по-новому на все принципы Бережливого производства. Всё стало более доступно. Читаешь «Дао Toyota» и непонятно, как на практике работать с этими инструментами, а вы донесли до нас. Очень понравилась работа в команде. Все вместе обсуждали важнейшие производственные вопросы. Круто! Спасибо вам!' },
  { name: 'Грачёв Дмитрий', role: 'Начальник производства', city: 'Тульская область',
    text: 'Вчера применил один из инструментов Профессионального Решения Проблем в личной жизни — работает 100%!!!' },
  { name: 'Пацук Виктор', role: 'Директор завода', city: 'Минеральные Воды',
    text: 'Очень хорошие впечатления. Программа тренинга почти идеальна. Она содержит самые важные инструменты и представляет их в логической последовательности. Очень обрадовала привязка к решению реальных проблем, а атмосфера команды значительно повышает вероятность успеха. На тренинге мы начали решать две проблемы, которые меня беспокоили больше всего. Причём начали решать не в форме планёрки, когда мы быстро принимаем решение, а потом долго его выполняем, а наоборот — теперь мы будем думать прежде чем что-то делать. Это позволит нам сделать качественный скачок.' },
  { name: 'Билалов Азат', role: 'Начальник производства', city: 'Учалы',
    text: 'Взбудоражило! Оказывается, все проблемы сидят глубже, чем мы представляем. На многие проблемы нужно смотреть не боясь. Всё круто и очень интересно!!!' },
  { name: 'Иванчикова Ирина', role: 'Руководитель коммерческой службы завода', city: 'Рязань',
    text: 'Хочу выразить свою благодарность за тренинг. За прошедший год для меня это самое интересное обучение. Тренинги были и раньше, многие базовые вещи были уже знакомы. Где-то мы просто встречались с теорией бережливого производства, книжки читали. Поэтому моей задачей было обрести практический инструментарий. Тренинг дал мне его — это очень ценно! Я думаю, теперь мы начнём применять эти инструменты у себя.' },
  { name: 'Спиридонов Андрей', role: 'Инженер-лаборант', city: 'Пушкин',
    text: 'Интересная и позитивная программа, позволяющая взглянуть на проблему с другой стороны.' },
  { name: 'Златенко Колев', role: 'Директор по персоналу', city: 'Болгария',
    text: 'Пять лет назад на нашем заводе в Болгарии Денис Булгин начал проводить курс обучения «Профессиональное Решение Проблем». На мой взгляд обучение прошло очень удачно. Полученный объём знаний пригодился специалистам нашего завода в решении всех производственных проблем, которые возникали на заводе за эти годы. Курс был подготовлен очень профессионально, очень оригинально. Тренинг имел успех. С уверенностью могу сказать, что программа обучения состоялась! В дальнейшем господином Булгиным было проведено обучение «Пока-Йоке — система бездефектного производства» — тоже очень интересная программа, которая пригодилась нашим сотрудникам. Спасибо за внимание!' },
  { name: 'Горлова Ирина', role: 'Зам. директора по коммерции', city: 'Рязань',
    text: 'Интересно и креативно! Я поняла, что проблема — это шаг к саморазвитию. Решение проблемы — это повышение нашей квалификации.' },
  { name: 'Бенц Станислав', role: 'Директор завода', city: 'Юрга',
    text: 'Супер! Все разделы и темы программы оказались ценными для меня. О них знал, но к своему стыду использовал редко! Было очень интересно. Всё, что планировал, я получил и даже больше. Необходимо работать над собой и применять полученные навыки!' },
  { name: 'Есин Роман', role: 'Начальник ПТО', city: 'Рязань',
    text: 'Я хотел получить Систему Профессионального Решения Проблем и я получил её. Всё прекрасно, доходчиво! Обалденно! Я очень доволен тренингом, это один из немногих действительно интересных и полезных. Тренингов много, но большинство — нудятина.' },
  { name: 'Щеглова Юлия', role: 'Инженер отдела технического контроля', city: 'Хабаровск',
    text: 'Программа очень мотивирует и вдохновляет. Благодаря тренингу у меня появился огромный запал. В голове с огромной скоростью заработали шестерёнки. Уверена, что по инерции они теперь будут работать очень и очень долгое время. До тренинга в поисках эффективных путей решения своих проблем, я не могла понять, какими всё-таки инструментами нужно пользоваться, с какой стороны подойти к задаче. Сейчас у меня в голове нарисовался чёткий план Профессионального Решения Проблем.' },
  { name: 'Будько Дмитрий', role: 'Начальник производства', city: 'Болгария',
    text: 'Очень хороший тренинг. Я думаю, что теперь мы сможем разговаривать на одном языке с моими коллегами при решении проблем.' },
  { name: 'Чебанов Михаил', role: 'Начальник производства', city: 'Хабаровск',
    text: 'Получил положительные эмоции, новые методы управления и решения проблем. Оправдались все ожидания, которые у меня были перед тренингом. Очень хорошо, качественно, подробно и понятно всё рассказано. Очень понравились командные игры. До этого я бывал на тренингах по Бережливому производству. Чем выгодно отличается «Профессиональное Решение Проблем» — тем, что на этом тренинг не закончился. Теперь у нас есть задание, которое нужно будет выполнять в течение 3–4 месяцев, применяя на практике полученные знания. Вот это очень понравилось!' },
  { name: 'Ерошкин Павел', role: 'Главный механик производства', city: 'Тульская область',
    text: 'Очень интересный тренинг. Я получил массу интересных знаний, которые собираюсь применять на практике. Спасибо огромное!!!' },
  { name: 'Ольчев Михаил', role: 'Директор завода', city: 'Рязань',
    text: 'По живости группы я понял, что тренинг пришёлся в самый-самый раз! Проблемы у нас назрели, проблемы у всех есть, все их озвучивали, все были активны. Никто не отсиживался на тренинге. На самом деле у всех есть потребность вот именно в этом тренинге. Реально, тренинг был интересным и нужным. Спасибо вам огромное!' },
  { name: 'Нестеренко Елена', role: 'Начальник производственной лаборатории', city: 'Юрга',
    text: 'Теорию Бережливого производства я уже слышала не один раз и при этом она мне была непонятна. В соединении с практикой, вы смогли наиболее доступно и понятно донести её до меня.' },
  { name: 'Петров Игорь', role: 'Начальник производства', city: 'Минеральные Воды',
    text: 'Хочу вас поблагодарить за предоставленную информацию. Некоторые из нас скептически были настроены до тренинга, таковых я сейчас не наблюдаю. Эффект получился большим для нас для всех. Очень важная и нужная программа. Считаю, что этот тренинг необходимо проводить не реже 3-х раз в год.' },
  { name: 'Дименко Игорь', role: 'Заместитель руководителя службы качества', city: 'Москва',
    text: 'Этот тренинг несёт в себе много важной и полезной информации, с помощью которой Компания добьётся своих целей.' },
  { name: 'Солотов Олег', role: 'Инженер-механик производства', city: 'Хабаровск',
    text: 'Очень понравилось! Для меня стала откровением визуальная стандартизация! Я теперь понял, что такое «5С», для чего это надо и как это работает. Реально доходит!' },
  { name: 'Майборода Ирина', role: 'Менеджер по ВЭД / планировщик производства', city: 'Днепродзержинск',
    text: 'Очень понравилась программа! Это не первое моё знакомство с бережливым производством. Если бы так мы начинали в своё время изучать эту увлекательную систему, то на сегодняшний день результатов у нас уже было бы гораздо больше. Очень доступное изложение материала, практически очень интересные занятия. Понравилось то, что Денис смог донести информацию и прямо зарядить её!!! Благодарю за отличные и плодотворные два дня. Они пролетели абсолютно незаметно!' },
  { name: 'Петрушкин Андрей', role: 'Коммерческий директор производства', city: 'Юрга',
    text: 'Всеобъемлющая, разнообразная программа, достаточно перемеженная теорией, практикой и юмором. Инструменты кайдзен ранее мне были знакомы, но инструмент «А3» увязал для меня все эти отдельные инструменты решения проблем в единую систему. Он связал всё в одно — вот это любопытно, этого я не знал! Вот это для меня здорово, что весь процесс решения проблем стал единым целым!' },
  { name: 'Ченторицкий Валерий', role: 'Директор завода', city: 'Пушкин',
    text: 'В отличие от предыдущего тренинга, очень впечатляюще и, главное, процесс не утомил. Предстоящая Защита проектов перед руководством гарантирует хорошую практическую работу групп. Для меня применение метода «ПРП» — это некая игра, это будет стимулировать решение проблем группами из-за того, что процесс будет не нудный, а приятный.' },
  { name: 'Абрамов Сергей', role: 'Менеджер по снабжению завода', city: 'Хабаровск',
    text: 'Когда я шёл на этот тренинг, когда я узнал, что он будет идти два дня, я подумал — потеряю два бесценных дня своей работы. На самом деле всё понравилось, всё круто! Я доволен, я получил очень много информации — поле для вспахивания! Есть над чем работать. Спасибо вам большое!' },
  { name: 'Пасюков Владимир', role: 'Инженер-электроник производства', city: 'Хабаровск',
    text: 'Для меня тренинг прошёл не зря. Сейчас на проблему я смотрю с другой стороны. Вижу, что есть куда расти. Вижу, как нужно разбирать проблему. Теперь я понимаю, что для достижения цели нужно следовать алгоритму ПРП. Спасибо огромное за тренинг. Обрёл для себя очень важный жизненный опыт.' },
  { name: 'Худяков Анастасия', role: 'Менеджер отдела региональных продаж', city: 'Москва',
    text: 'Было интересно и познавательно. Представилась возможность получить новую схему действий при решении проблем. Полезно и для решения своих трудностей. Стало не так страшно думать о проблемах!' },
  { name: 'Нюхтиков Евгений', role: 'Инженер-конструктор', city: 'Москва',
    text: 'Обучение было интересным, динамичным, полезным. Данный тренинг прошёл для меня очень легко. Намного более легко, чем все тренинги, в которых я участвовал ранее. Очень полезно, что есть привязка к конкретному производству и проблемам, которые реально существуют, которых мы касаемся в своей работе.' },
  { name: 'Горобец Роман', role: 'Менеджер по сырью', city: 'Минеральные Воды',
    text: 'Отличная программа. Я получил правильный профессиональный подход к решению проблем и понял, что не решаемых проблем не бывает. Работая в команде и применяя полученные инструменты, мы очень много сможем решить важных для нас на сегодняшний день проблем. Очень полезный и нужный тренинг!' },
  { name: 'Идрисов Марат', role: 'Директор завода', city: 'Ново-Ульяновск',
    text: 'Необходимо продолжать в том же ключе. Атмосфера обучающейся команды будет продолжена с Вашей помощью. Единственное, что могло бы улучшить программу — танцы, объединяющие группу :)' },
  { name: 'Алексеев Пётр', role: 'Заместитель начальника производства', city: 'Москва',
    text: 'Очень важный тренинг. Я узнал пошаговые действия по выявлению, анализу и решению проблем с помощью инструментов кайдзен. Считаю, что такой тренинг пригодится любому человеку в любой отрасли, в любом деле.' },
  { name: 'Серебряков Павел', role: 'Начальник ТСК', city: 'Ново-Ульяновск',
    text: 'Очень познавательные и ценные занятия. Тренинг раскрывает скрытый потенциал как одного сотрудника, так и группы в целом.' },
  { name: 'Целин Роман', role: 'Менеджер дилерского отдела', city: 'Санкт-Петербург',
    text: 'Особенно полезной для меня стала возможность более глубоко подойти к анализу своей повседневной профессиональной деятельности, повысить самоконтроль путём применения новых инструментов.' },
  { name: 'Дронова Валентина', role: 'Менеджер московского отдела', city: 'Москва',
    text: 'Замечательный тренинг. Узнаёшь много вещей, которые существовали ранее, но на них не обращалось внимание. Теперь будет проще решить любую проблему.' },
  { name: 'Татьяна Христова Славова', role: 'Главный бухгалтер производства', city: 'Болгария',
    text: 'До сих пор я никогда не участвовала в таком обучении. Для меня это очень важное обучение, оно усовершенствовало мою мысль. Раньше мы решали проблемы, но многие из них опять возвращались в исходные позиции. Решение проблем всегда воспринималось как досадная обязанность, теперь я буду решать проблемы с удовольствием.' },
  { name: 'Морозов Алексей', role: 'Начальник ССК', city: 'Рязань',
    text: 'Получил новые знания по решению проблем. Наконец-то у меня состыковалось бережливое производство с решением реальных проблем. Раньше всё это было только в теории.' },
  { name: 'Благуш Даниил', role: 'Директор филиала', city: 'Ростов-на-Дону',
    text: 'Хотелось бы продолжить обучение в предложенном формате и далее! Кратко, понятно, не размыто, полезно. Спасибо!' },
  { name: 'Перегудин Сергей', role: 'Заместитель руководителя службы качества', city: 'Тульская область',
    text: 'Изложение и подачу материала бизнес-тренером считаю очень удачным. Всё хорошо запоминается, материал усваивается без напряжения.' },
  { name: 'Ткачёв Василий', role: 'Директор', city: 'СБЕ «Полимерная изоляция»',
    text: 'Я очень рад, что у нас есть интересные проекты, которые реально очень важны и для подразделения, и для СБЕ в целом. Мне нравится, что теперь, решая проблемы, мы будем говорить на одном языке. Очень хочется, чтобы как можно больше коллег на других заводах нашли свои больные точки и сделали свои важные ПРП-проекты на своих заводах.' },
  { name: 'Сорокина Мария', role: 'Директор по маркетингу', city: 'СБЕ «Полимерная изоляция»',
    text: 'Мне ценно, что тренинг даёт системный подход к решению проблем. Всё очень красиво, системно и последовательно. Спасибо большое!' },
];

/* Раздача по трём рядам через шаг 3 (14/14/13) — короткие панчи из курированного
   начала массива распределяются по всем рядам равномерно. */
const rows = [0, 1, 2].map((k) => REVIEWS.filter((_, i) => i % 3 === k));

/* Скорость рядов: полный цикл ~2 минуты. Средний ряд едет навстречу и медленнее
   всех — встречное движение читается даже на малой скорости. */
const rowConfig = [
  { dur: '110s', reverse: false },
  { dur: '150s', reverse: true },
  { dur: '125s', reverse: false },
];
---

<!-- ========== БЛОК «ОТЗЫВЫ» ==========
     Последняя секция страницы: слайдер видеоотзывов (VideoReviews.astro) +
     три встречных бегущих ряда текстовых карточек («Конвейер» из
     wireframes/reviews.html). relative z-10 + непрозрачный bg обязательны:
     без них сквозь секцию проступают fixed-слои hero (Денис и гора).
     Клик по текстовой карточке открывает полный текст в <dialog>
     (ModalReview.astro, логика — src/scripts/reviews.ts, подключён там же). -->
<section id="reviews" class="relative z-10 bg-bg section-py">
  <div class="w-full section-px">
    <div class="text-center max-w-3xl mx-auto">
      <p class="t-eyebrow t-on-muted mb-6">Что говорят люди?</p>
      <h2 class="t-h-section t-on-brand">Отзывы <span class="text-brand-red">участников</span></h2>
      <p class="t-hint t-on-muted mt-4">Нажмите на&nbsp;карточку, чтобы посмотреть видео или прочитать отзыв целиком.</p>
    </div>
  </div>

  <VideoReviews />

  <!-- Ряды на всю ширину вьюпорта, без section-px. Edge-fade по краям — от фона
       секции (bg-bg) к прозрачному, чтобы карточки «выезжали из-за кулис». -->
  <div class="relative mt-[clamp(2.5rem,5vw,4.5rem)] space-y-5">
    <div class="pointer-events-none absolute inset-y-0 left-0 w-12 md:w-24 z-10 bg-gradient-to-r from-bg to-transparent" aria-hidden="true"></div>
    <div class="pointer-events-none absolute inset-y-0 right-0 w-12 md:w-24 z-10 bg-gradient-to-l from-bg to-transparent" aria-hidden="true"></div>

    {rows.map((row, k) => (
      <div class="marquee" role="region" aria-label={`Отзывы, ряд ${k + 1}`}>
        <div
          class:list={['marquee__track', rowConfig[k].reverse && 'marquee__track--r']}
          style={`--marquee-dur: ${rowConfig[k].dur};`}
        >
          {[false, true].map((dup) =>
            row.map((r) => (
              <button
                type="button"
                data-review-card
                data-name={r.name}
                data-role={r.role}
                data-city={r.city}
                class="review-card w-[300px] md:w-[360px] shrink-0 mr-4 p-5 text-left flex flex-col"
                {...(dup ? { 'data-dup': '', 'aria-hidden': 'true', tabindex: '-1' } : {})}
              >
                {/* Без `block` на тексте: он перебил бы display:-webkit-box у line-clamp */}
                <span class="review-card__text t-body-sm t-on-default line-clamp-5">{r.text}</span>
                <span class="mt-auto pt-4 flex flex-wrap items-baseline gap-x-3 gap-y-0.5">
                  <span class="review-card__name t-meta font-semibold t-on-strong">{r.name}</span>
                  <span class="review-card__meta t-hint t-on-muted">{r.city}</span>
                </span>
              </button>
            ))
          )}
        </div>
      </div>
    ))}
  </div>
</section>
