---
interface Step {
  num: number;
  text: string;
}

const steps: Step[] = [
  { num: 1, text: 'Обучение сотрудников компании навыкам ПРП (топ-менеджмент — среднее звено (ИТР) — линейный персонал («рабочие на полу»)' },
  { num: 2, text: 'Выбор реально существующей проблемы для проектного решения методами ПРП' },
  { num: 3, text: 'Групповая проектная 3х-месячная работа над практическим проектом ПРП' },
  { num: 4, text: 'Защита практического проекта ПРП перед внутренней экспертной группой (оценка эффективности решения проблемы)' },
  { num: 5, text: 'Максимизация и категоризация принятых в ходе ПРП-решений внутри компании' },
];
---

<!-- ========== БЛОК «ШАГИ ПО ВНЕДРЕНИЮ СИСТЕМЫ ПРП» ========== -->
<!-- xl:pb — ровно половина ступени section: у stage-«креста» (aspect 13/10)
     под октагоном 5 есть встроенная пустота ~4% ширины stage, полный ритм
     к ней добавлял бы ещё целую ступень и низ выглядел заметно толще верха.
     На <xl (колонка) пустоты нет — там паддинг симметричный.
     Считается от токена, а не своим clamp'ом: сдвинется шкала — сдвинется и он. -->
<section id="prp-steps" class="relative z-10 bg-bg section-py xl:pb-[calc(var(--spacing-section)/2)]">
  <!-- section-px-wide: диаграмма — «ковёр», на lg+ ей отдаётся ширина. -->
  <div class="w-full section-px-wide">
    <div>

      <!-- Reveal достаётся только заголовку: сама диаграмма ниже привязана
           к скроллу через GSAP ScrollTrigger (src/scripts/prp-diagram-scroll.ts),
           и второй приём появления поверх неё был бы двойной анимацией. -->
      <div class="mb-group xl:mb-0 max-w-prose mx-auto text-center" data-reveal>
        <p class="t-eyebrow t-on-muted mb-6">Процесс внедрения</p>
        <h2 class="t-h-section t-on-brand">
          Шаги по&nbsp;внедрению системы <span class="text-brand-red">ПРП</span>
        </h2>
      </div>

      <div class="prp-diagram-stage">

        <!-- SVG-спрайт: форма октагона. Один <symbol>, на который ссылаются 5 <use>.
             Сплошная заливка fill="currentColor" — фон карточки, без обводки. -->
        <svg width="0" height="0" style="position:absolute" aria-hidden="true">
          <symbol id="prp-octagon-shape" viewBox="0 0 100 100">
            <path fill="currentColor" d="M 12 0 L 88 0 L 100 12 L 100 88 L 88 100 L 12 100 L 0 88 L 0 12 Z" />
          </symbol>
        </svg>

        <!-- Описание Системы ПРП. На <lg — обычный текстовый блок, на lg+ — прозрачная карточка в кресте. -->
        <article class="prp-intro">
          <p class="prp-intro__text t-body t-on-default">
            <strong class="font-semibold t-on-strong">Система&nbsp;ПРП</strong> —
            единая система управления процессом Профессионального Решения Проблем,
            основанная на&nbsp;базовых принципах бережливого производства
            (кайдзен-менеджмента). Принята для&nbsp;обязательного, всеобщего
            применения во&nbsp;всех структурных подразделениях компании.
          </p>
        </article>

        <!-- Центральный узор — INLINE SVG. GSAP анимирует stroke-dasharray/fillOpacity.
             Цвет — fill/stroke="currentColor"; сам цвет задаёт .prp-ornament в global.css
             токеном --color-brand-red (фирменный красный). -->
        <svg class="prp-ornament" viewBox="0 0 70 70"
             xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
          <path class="prp-ornament__path" pathLength="1" stroke="currentColor" stroke-width="1.2" stroke-linejoin="miter" fill="currentColor" d="M26.6619 0.138845L15.1855 11.6152L19.6681 16.0978L31.1445 4.62144L26.6619 0.138845Z" />
          <path class="prp-ornament__path" pathLength="1" stroke="currentColor" stroke-width="1.2" stroke-linejoin="miter" fill="currentColor" d="M42.1187 0.000429039L22.8506 19.2686L27.3332 23.7512L46.6013 4.48303L42.1187 0.000429039Z" />
          <path class="prp-ornament__path" pathLength="1" stroke="currentColor" stroke-width="1.2" stroke-linejoin="miter" fill="currentColor" d="M53.5349 3.87719L30.5 26.9121L34.9826 31.3947L58.0175 8.35979L53.5349 3.87719Z" />
          <path class="prp-ornament__path" pathLength="1" stroke="currentColor" stroke-width="1.2" stroke-linejoin="miter" fill="currentColor" d="M4.62224 38.7235L0.139648 43.2061L11.616 54.6824L16.0986 50.1998L4.62224 38.7235Z" />
          <path class="prp-ornament__path" pathLength="1" stroke="currentColor" stroke-width="1.2" stroke-linejoin="miter" fill="currentColor" d="M4.4826 23.3065L0 27.7891L19.2681 47.0572L23.7507 42.5746L4.4826 23.3065Z" />
          <path class="prp-ornament__path" pathLength="1" stroke="currentColor" stroke-width="1.2" stroke-linejoin="miter" fill="currentColor" d="M8.40154 11.909L3.91895 16.3916L26.9539 39.4265L31.4365 34.9439L8.40154 11.909Z" />
          <path class="prp-ornament__path" pathLength="1" stroke="currentColor" stroke-width="1.2" stroke-linejoin="miter" fill="currentColor" d="M50.2645 53.8713L38.7881 65.3477L43.2707 69.8303L54.7471 58.3539L50.2645 53.8713Z" />
          <path class="prp-ornament__path" pathLength="1" stroke="currentColor" stroke-width="1.2" stroke-linejoin="miter" fill="currentColor" d="M42.5982 46.2026L23.3301 65.4707L27.8127 69.9533L47.0808 50.6852L42.5982 46.2026Z" />
          <path class="prp-ornament__path" pathLength="1" stroke="currentColor" stroke-width="1.2" stroke-linejoin="miter" fill="currentColor" d="M34.946 38.5569L11.9111 61.5918L16.3937 66.0744L39.4286 43.0395L34.946 38.5569Z" />
          <path class="prp-ornament__path" pathLength="1" stroke="currentColor" stroke-width="1.2" stroke-linejoin="miter" fill="currentColor" d="M58.384 15.1854L53.9014 19.668L65.3778 31.1444L69.8604 26.6618L58.384 15.1854Z" />
          <path class="prp-ornament__path" pathLength="1" stroke="currentColor" stroke-width="1.2" stroke-linejoin="miter" fill="currentColor" d="M50.7316 22.8338L46.249 27.3164L65.5172 46.5845L69.9997 42.1019L50.7316 22.8338Z" />
          <path class="prp-ornament__path" pathLength="1" stroke="currentColor" stroke-width="1.2" stroke-linejoin="miter" fill="currentColor" d="M43.0275 30.4647L38.5449 34.9473L61.5798 57.9822L66.0624 53.4996L43.0275 30.4647Z" />
        </svg>

        <ol class="prp-diagram">
          {steps.map((s) => (
            <li class={`prp-octagon prp-octagon--${s.num}`}>
              <svg viewBox="0 0 100 100" class="prp-octagon__shape" aria-hidden="true">
                <use href="#prp-octagon-shape" />
              </svg>
              {s.num !== 5 && <span class="prp-octagon__arrowhead" aria-hidden="true"></span>}
              <div class="prp-octagon__body">
                <span class="prp-octagon__num t-on-dark" aria-hidden="true">{s.num}</span>
                <p class="prp-octagon__text t-on-dark" set:html={s.text}></p>
              </div>
            </li>
          ))}

          <!-- ДЕКОР: возвратная стрелка 5→2 для mobile-колонки (CSS-«скобка»). -->
          <div class="prp-return" aria-hidden="true"></div>
        </ol>

        <!-- ДЕКОР: стрелки desktop. viewBox 0 0 130 100 = aspect 13/10.
             Линии и наконечник — currentColor; цвет наследуется от .prp-arrows
             (токен --color-brand-red), включая <marker> внутри <defs>. -->
        <svg class="prp-arrows prp-arrows--desktop" viewBox="0 0 130 100"
             preserveAspectRatio="none" aria-hidden="true">
          <defs>
            <marker id="prpArrowHead" viewBox="0 0 10 10" refX="8.5" refY="5"
                    markerWidth="1.2" markerHeight="1.2" orient="auto-start-reverse"
                    markerUnits="userSpaceOnUse">
              <path d="M0,0 L10,5 L0,10 Z" fill="currentColor" />
            </marker>
          </defs>
          <path d="M 28.7 50 L 35 50" fill="none" stroke="currentColor" stroke-width="2" vector-effect="non-scaling-stroke" marker-end="url(#prpArrowHead)" />
          <path d="M 62.72 37.34 Q 63.40 32.43 68.32 31.76" fill="none" stroke="currentColor" stroke-width="2" vector-effect="non-scaling-stroke" marker-end="url(#prpArrowHead)" />
          <path d="M 93.66 31.76 Q 98.58 32.43 99.26 37.34" fill="none" stroke="currentColor" stroke-width="2" vector-effect="non-scaling-stroke" marker-end="url(#prpArrowHead)" />
          <path d="M 99.26 62.66 Q 98.58 67.57 93.66 68.24" fill="none" stroke="currentColor" stroke-width="2" vector-effect="non-scaling-stroke" marker-end="url(#prpArrowHead)" />
          <path d="M 68.32 68.24 Q 63.40 67.57 62.72 62.66" fill="none" stroke="currentColor" stroke-width="2" vector-effect="non-scaling-stroke" marker-end="url(#prpArrowHead)" />
        </svg>

      </div>

    </div>
  </div>
</section>

<script>
  import '../scripts/prp-diagram-scroll';
</script>
