---
import IconClose from './IconClose.astro';
import BsFallbackOverlay from './BsFallbackOverlay.astro';
---

<!-- ========== МОДАЛКА ВИДЕООТЗЫВА ==========
     Один <dialog> на все 12 видео: iframe ЕДИНСТВЕННЫЙ и без src — адрес
     плеера устанавливает src/scripts/video-reviews.ts при открытии (ничего
     не грузится заранее), при закрытии src сбрасывается в about:blank
     (мгновенная остановка звука). Оверлей-фолбэк тот же, что у статического
     BoomStreamPlayer.astro, но обёртка помечена data-bs-player-modal —
     автоскан watchdog'а её не трогает, таймером управляет arm()/disarm(). -->
<dialog id="modal-video-review" aria-label="Видеоотзыв" data-lenis-prevent class="modal-scroll">
  <button type="button" id="modal-video-close" aria-label="Закрыть" class="modal-video-close">
    <IconClose />
  </button>

  <figure class="modal-video-card">
    <div class="relative w-full aspect-video bg-ink-dark overflow-hidden" data-bs-player-modal>
      <iframe
        id="modal-video-iframe"
        class="absolute inset-0 w-full h-full"
        frameborder="0"
        scrolling="no"
        allow="autoplay; fullscreen"
        title="Видеоотзыв участника тренинга"
        data-bs-code=""
      ></iframe>

      <!-- Оверлей-фолбэк watchdog'а (VPN и пр.) — переключает
           boomstream-watchdog.ts: hidden <-> flex + aria-hidden. -->
      <BsFallbackOverlay />
    </div>

    <div class="p-panel">
      <figcaption id="modal-video-caption" class="flex flex-wrap items-baseline gap-x-3 gap-y-1 mb-6">
        <span id="modal-video-name" class="font-semibold t-on-strong"></span>
        <span id="modal-video-meta" class="t-meta t-on-muted"></span>
      </figcaption>

      <!-- Абзацы расшифровки клонируются из <template> карточки
           (уже с классами t-body t-on-default). -->
      <div id="modal-video-transcript" class="space-y-[1em]"></div>
    </div>
  </figure>
</dialog>

<script>
  import '../scripts/video-reviews';
</script>
