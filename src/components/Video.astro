---
import BoomStreamPlayer from './BoomStreamPlayer.astro';
import mountainsNight from '../assets/images/mountains-night.jpg';
---

<!-- ========== БЛОК «ВИДЕО-ПРИГЛАШЕНИЕ» ========== -->
<!-- Фон-панорама + стальной оверлей — тот же приём, что в #offer-stats.
     Секция обязана быть непрозрачной и z-10, иначе сквозь неё проступают
     fixed-слои hero (см. CLAUDE.md, раздел про стэкинг). -->
<section
  id="video"
  class="relative z-10 overflow-hidden bg-cover bg-center bg-fixed section-py"
  style={`background-image: url('${mountainsNight.src}');`}
>
  <!-- Оверлей в модификации --soft: снимок ночной, сам по себе тёмный, и полная
       альфа .steel-overlay (0.84) съела бы горы в чёрное. -->
  <div class="absolute inset-0 steel-overlay steel-overlay--soft" aria-hidden="true"></div>
  <div class="absolute inset-0 bg-gradient-to-b from-wire-accent2/45 via-transparent to-wire-accent2/35" aria-hidden="true"></div>

  <div class="relative w-full section-px">
    <div class="mx-auto w-full max-w-[clamp(40rem,78vw,90rem)]">
      <BoomStreamPlayer code="nm7YeR0q" title="Учебный курс «Профессиональное Решение Проблем»" />
    </div>
  </div>
</section>
