---
/* ========== БЛОК «ФОТОГРАФИИ С ТРЕНИНГОВ» ==========
   Masonry-лента во всю ширину экрана. Кадры сняты на РАЗНЫХ программах Дениса
   (не только «Профессиональное решение проблем»), поэтому заголовок, надзаголовок
   и alt-тексты сознательно нейтральны к теме конкретного тренинга.

   Два комплекта файлов с совпадающими именами (до расширения):
   — preview/*.jpg  — 800px по длинной стороне, идут в сетку через <Image />;
   — full/*.webp    — ≤1920px, уже готовы к отдаче, уходят в лайтбокс как есть.
   Превью грузятся сразу (lazy), большой кадр — только по клику.

   Почему full НЕ прогоняется через getImage(): Astro эмитит в dist/ исходник
   каждого импортированного изображения, и для картинок, идущих через getImage()
   (а не через <Image />), лишний оригинал из сборки не вычищается — на 93 кадрах
   это давало 35 МБ мёртвого груза. Поэтому кадры ужаты заранее скриптом
   scripts/prepare-training-photos.mjs, а здесь просто импортируются. */
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

const previewFiles = import.meta.glob<{ default: ImageMetadata }>(
  '../assets/images/trainings/preview/*.jpg',
  { eager: true },
);
const fullFiles = import.meta.glob<{ default: ImageMetadata }>(
  '../assets/images/trainings/full/*.webp',
  { eager: true },
);

/* Alt-тексты: нейтральные формулировки, ротация по индексу. Пофайлового описания
   намеренно нет — 93 кадра, содержательной разницы между «участники за работой»
   на снимке 14 и 61 нет, а выдуманная конкретика в alt хуже обобщённой правды. */
const ALTS: string[] = [
  'Денис Булгин ведёт корпоративный тренинг для группы участников',
  'Участники тренинга разбирают рабочий кейс в малой группе',
  'Разбор задачи у флипчарта на очном тренинге Дениса Булгина',
  'Групповая работа участников корпоративного тренинга',
  'Денис Булгин объясняет инструмент методики участникам тренинга',
  'Команда представляет результаты практического задания',
  'Обсуждение решения проблемы в ходе корпоративного обучения',
  'Практическое упражнение на очном тренинге для сотрудников компании',
  'Участники тренинга за работой над проектом улучшений',
  'Денис Булгин отвечает на вопросы участников тренинга',
  'Работа с раздаточными материалами тренинга в аудитории',
  'Рабочий момент корпоративного тренинга Дениса Булгина',
];

const slugs = Object.keys(previewFiles)
  .map((p) => p.split('/').pop()!.replace(/\.jpg$/, ''))
  .sort();

const photos = slugs.map((slug, i) => {
  const preview = previewFiles[`../assets/images/trainings/preview/${slug}.jpg`];
  const full = fullFiles[`../assets/images/trainings/full/${slug}.webp`];
  if (!preview || !full) {
    throw new Error(`TrainingPhotos.astro: нет пары preview/full для ${slug}`);
  }

  return {
    preview: preview.default,
    alt: ALTS[i % ALTS.length],
    fullUrl: full.default.src,
    fullWidth: full.default.width,
    fullHeight: full.default.height,
  };
});

/* JSON-LD ImageGallery. В схему кладём первые 12 кадров: 93 объекта раздули бы
   HTML на ~30 КБ, а поисковику для понимания типа страницы хватает выборки. */
const baseRaw = import.meta.env.BASE_URL;
const base = baseRaw.endsWith('/') ? baseRaw : `${baseRaw}/`;
const canonical = new URL(base, Astro.site).toString();

const gallerySchema = {
  '@context': 'https://schema.org',
  '@type': 'ImageGallery',
  name: 'Фотографии с тренингов Дениса Булгина',
  description:
    'Снимки с очных корпоративных тренингов Дениса Булгина: групповая работа, разбор кейсов, презентация результатов.',
  url: `${canonical}#training-photos`,
  inLanguage: 'ru',
  associatedMedia: photos.slice(0, 12).map((p) => ({
    '@type': 'ImageObject',
    contentUrl: new URL(p.fullUrl, Astro.site).toString(),
    caption: p.alt,
    creditText: 'PDCA Consulting',
  })),
};
---

<!-- Секция ниже hero: relative z-10 + непрозрачный фон обязательны,
     иначе сквозь неё проступают fixed-слои героики (см. CLAUDE.md). -->
<section id="training-photos" class="relative z-10 bg-bg py-[clamp(3.5rem,7vw,7rem)]">

  <div class="section-px">
    <header class="max-w-prose mx-auto text-center">
      <p class="t-eyebrow t-on-soft mb-4">Очные корпоративные программы</p>
      <h2 class="t-h-section t-on-brand">
        Фотографии с <span class="text-brand-red">тренингов</span>
      </h2>
    </header>
  </div>

  <!-- Ковёр во всю ширину: контейнера с max-w нет, боковые поля равны зазору
       между кадрами (--gallery-gap), поэтому решётка читается как единое поле. -->
  <ul id="training-gallery" class="gallery-masonry">
    {photos.map((p) => (
      <li class="gallery-cell">
        <button
          type="button"
          class="gallery-item"
          data-gallery-item
          data-full={p.fullUrl}
          data-w={p.fullWidth}
          data-h={p.fullHeight}
          data-alt={p.alt}
          aria-label={`${p.alt}. Открыть во весь экран`}
        >
          <Image
            src={p.preview}
            widths={[320, 480, 800]}
            sizes="(min-width: 1536px) 17vw, (min-width: 1024px) 20vw, (min-width: 640px) 25vw, (min-width: 480px) 33vw, 50vw"
            format="webp"
            alt={p.alt}
            loading="lazy"
            decoding="async"
            class="gallery-item__img"
          />
          <span class="gallery-item__hint" aria-hidden="true">
            <span>Открыть</span>
          </span>
        </button>
      </li>
    ))}
  </ul>

  <div class="section-px mt-[clamp(1.75rem,3vw,2.75rem)] text-center">
    <button type="button" id="training-gallery-more" class="btn-video-retry" hidden>
      Показать ещё
    </button>
  </div>

  <!-- Свёртку включаем синхронным inline-скриптом, а не разметкой: без JS кнопка
       «Показать ещё» не заработает, и клип оставил бы 60+ кадров недостижимыми.
       is:inline + позиция сразу после разметки = состояние выставлено до первой
       отрисовки, лента не успевает мигнуть полной высотой. -->
  <script is:inline>
    (function () {
      var g = document.getElementById('training-gallery');
      var b = document.getElementById('training-gallery-more');
      if (g && b) {
        g.setAttribute('data-collapsed', '');
        b.hidden = false;
      }
    })();
  </script>

</section>

<script is:inline type="application/ld+json" set:html={JSON.stringify(gallerySchema)}></script>

<script>
  import '../scripts/gallery';
</script>
