---
import logoSvg from '../assets/svg/logo-prp.svg?raw';

interface Props {
  class?: string;
}

const { class: className = 'h-10 md:h-11 w-auto block' } = Astro.props;
---

<Fragment set:html={logoSvg} />
<svg viewBox="0 0 216 56" class={className} aria-label="PDCA Consulting" preserveAspectRatio="xMinYMid meet">
  <use href="#logo-prp" />
</svg>
