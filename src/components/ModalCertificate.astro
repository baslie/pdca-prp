---
// Лайтбокс сертификата. Рендерится в index.astro только вместе с реальным
// сканом — пока картинки нет, блок #certificate показывает статичный лист
// без кнопки, и открывать нечего.
import type { ImageMetadata } from 'astro';

interface Props {
  image: ImageMetadata;
}

const { image } = Astro.props;
---

<!-- ========== ЛАЙТБОКС СЕРТИФИКАТА ==========
     Схема входа/выхода — как у #modal-examples (backdrop + карточка),
     а не circular reveal из #modal-about: тот fullscreen-приём привязан
     к кнопке-триггеру в потоке текста, здесь он не нужен. -->
<dialog id="modal-certificate" class="modal-scroll"
        aria-label="Сертификат тренинга «Профессиональное решение проблем»">
  <div class="modal-certificate-card">
    <!-- Габариты картинки считает CSS (.modal-certificate-card img): лист
         вписывается по высоте вьюпорта, ширину диктует его пропорция. -->
    <img src={image.src} alt="Сертификат тренинга «Профессиональное решение проблем»"
         width={image.width} height={image.height} />
  </div>

  <button type="button" id="modal-certificate-close" aria-label="Закрыть"
          class="modal-certificate-close">
    <svg xmlns="http://www.w3.org/2000/svg" aria-hidden="true" class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
      <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
    </svg>
  </button>
</dialog>

<script>
  import '../scripts/certificate';
</script>
