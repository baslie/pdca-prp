---
/**
 * Значок «?» рядом с термином + всплывающая подсказка.
 *
 * Показ — CSS-only: наведение мышью (@media hover) и :focus на кнопке,
 * что покрывает тап на тач-устройствах (тап ставит фокус). Скрипт решает
 * две задачи, которые чистым CSS не решаются: держит пузырь внутри вьюпорта
 * и гасит подсказку по Esc, не закрывая заодно <dialog>, внутри которого
 * значок может стоять.
 *
 * Стили — .termtip* в src/styles/global.css (@layer components),
 * логика — src/scripts/termtip.ts.
 */
interface Props {
  /** Текст подсказки. */
  text: string;
  /** Поясняемое слово — уходит в aria-label, чтобы скринридер прочитал пару «термин: расшифровка». */
  term?: string;
}

const { text, term } = Astro.props;
---

<span class="termtip">
  <button type="button" class="termtip__btn" aria-label={term ? `${term} — ${text}` : text}>?</button>
  <span class="termtip__bubble" aria-hidden="true">{text}</span>
</span>

<script>
  import '../scripts/termtip';
</script>
