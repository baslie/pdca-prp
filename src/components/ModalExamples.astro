<!-- ========== КОМПАКТНАЯ МОДАЛКА КАТЕГОРИЙ ==========
     Открывается по клику на любую кнопку с data-category в #examples.
     Контент заполняется JS-ом (src/scripts/examples.ts). -->
<dialog id="modal-examples" aria-labelledby="modal-examples-title" class="modal-scroll">
  <div class="modal-examples-card">
    <div class="flex items-start justify-between gap-4 px-6 md:px-8 py-5 border-b border-neutral-200">
      <div class="flex items-start gap-4">
        <div id="modal-examples-icon" class="w-14 h-14 bg-wire-panel text-wire-dark flex items-center justify-center shrink-0"></div>
        <div>
          <h3 id="modal-examples-title" class="t-h-section t-h-section--compact t-on-strong"></h3>
          <div id="modal-examples-count" class="t-eyebrow t-on-muted mt-1"></div>
        </div>
      </div>
      <button type="button" id="modal-examples-close" aria-label="Закрыть"
              class="w-9 h-9 flex items-center justify-center bg-wire-panel text-wire-dark hover:bg-wire-dark hover:text-white transition-colors shrink-0">
        <svg xmlns="http://www.w3.org/2000/svg" aria-hidden="true" class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
        </svg>
      </button>
    </div>

    <div class="px-6 md:px-8 py-6">
      <ul id="modal-examples-list" class="space-y-2.5 px-3"></ul>
    </div>
  </div>
</dialog>

<script>
  import '../scripts/examples';
</script>
