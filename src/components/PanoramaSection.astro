---
/* Секция-панорама: фоновое фото гор (bg-fixed) + двухслойный оверлей —
   «стальной» синий .steel-overlay (см. global.css) и вертикальная виньетка
   фирменным синим. Повторялась дословно в трёх секциях; теперь кодифицирует
   железное правило docs/STACKING.md: каждая секция после hero — relative z-10
   с непрозрачным фоном, иначе сквозь неё проступают fixed-слои hero.
   Сайты: #offer-stats, #video, #request. */
import type { ImageMetadata } from 'astro';

interface Props {
  id: string;
  /** Фоновая панорама — импорт из src/assets. */
  image: ImageMetadata;
  /** Оверлей в модификации --soft: полная альфа .steel-overlay (0.84)
      съела бы фактуру ч/б-панорамы в чёрное. Используется у #video. */
  soft?: boolean;
}

const { id, image, soft = false } = Astro.props;

const overlayClass = soft
  ? 'absolute inset-0 steel-overlay steel-overlay--soft'
  : 'absolute inset-0 steel-overlay';
---

<section
  {id}
  class="relative z-10 overflow-hidden section-py-lg bg-cover bg-center bg-fixed"
  style={`background-image: url('${image.src}');`}
>
  <div class={overlayClass} aria-hidden="true"></div>
  <div class="absolute inset-0 bg-gradient-to-b from-brand-blue/45 via-transparent to-brand-blue/35" aria-hidden="true"></div>
  <slot />
</section>
