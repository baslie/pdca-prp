---
import BaseLayout from '../layouts/BaseLayout.astro';
import DenisFixed from '../components/DenisFixed.astro';
import Hero from '../components/Hero.astro';
import AboutTraining from '../components/AboutTraining.astro';
import Video from '../components/Video.astro';
import Examples from '../components/Examples.astro';
import OfferStats from '../components/OfferStats.astro';
import PrpSteps from '../components/PrpSteps.astro';
import AboutTrainer from '../components/AboutTrainer.astro';
import Certificate from '../components/Certificate.astro';
import Clients from '../components/Clients.astro';
import Reviews from '../components/Reviews.astro';
import TrainingPhotos from '../components/TrainingPhotos.astro';
import LeadForm from '../components/LeadForm.astro';
import ModalAbout from '../components/ModalAbout.astro';
import ModalExamples from '../components/ModalExamples.astro';
import ModalCertificate from '../components/ModalCertificate.astro';
import ModalReview from '../components/ModalReview.astro';
import ModalVideoReview from '../components/ModalVideoReview.astro';
import ModalGallery from '../components/ModalGallery.astro';
// Когда придёт скан сертификата: положить файл в src/assets/images/,
// раскомментировать импорт ниже и передать картинку в ОБА компонента —
// <Certificate image={certificateScan} /> и <ModalCertificate image={certificateScan} />.
// До тех пор и превью, и лайтбокс показывают лист-заглушку.
// import certificateScan from '../assets/images/certificate-euclides.jpg';
---

<BaseLayout>
  <!-- DOM-order для hero fixed-слоёв (mix-blend-difference требует одного stacking context).
       Денис рендерится ДО hero, чтобы плотность blending'а с h1 и цитатой работала корректно. -->
  <DenisFixed />

  <Hero />

  <AboutTraining />

  <Video />

  <Examples />

  <OfferStats />

  <PrpSteps />

  <AboutTrainer />

  <Certificate />

  <Clients />

  <Reviews />

  <TrainingPhotos />

  <!-- Целевое действие страницы и последний блок ленты. Якорь #request —
       на него будут вести CTA.
       Концевого «воздушного» div'а здесь нет намеренно: полоса белого под
       тёмной секцией читалась как обрыв вёрстки, а собственный нижний паддинг
       у #request (ступень section-lg) уже даёт финалу воздух. Когда появится
       футер (бэклог README, п. 3) — он встанет сразу после LeadForm. -->
  <LeadForm />

  <ModalAbout />
  <ModalExamples />
  <ModalCertificate />
  <ModalReview />
  <ModalVideoReview />
  <ModalGallery />
</BaseLayout>
